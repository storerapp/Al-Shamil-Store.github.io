NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_KEY=replace-with-a-long-random-secret

# Panel: V10 ships safely disabled until your real panel is entered
PANEL_ENABLED=false
PANEL_URL=https://panel.example.com
PANEL_PUBLIC_URL=https://panel.example.com
PANEL_API_KEY=
PANEL_EGG_ID=15
PANEL_NEST_ID=
PANEL_LOCATION_ID=1
PANEL_EMAIL_DOMAIN=clients.example.com
PANEL_DOCKER_IMAGE=
PANEL_STARTUP=
PANEL_MEMORY_MB=1024
PANEL_DISK_MB=5120
PANEL_CPU=100
PANEL_SWAP_MB=0
PANEL_IO=500
PANEL_DATABASE_LIMIT=1
PANEL_ALLOCATION_LIMIT=1
PANEL_BACKUP_LIMIT=0
